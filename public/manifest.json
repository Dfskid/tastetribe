  "shortcuts": [
    {
      "name": "Discover",
      "short_name": "Discover",
      "description": "Find new restaurants near you",
      "url": "/discover?source=shortcut",
      "icons": [{ "src": "/icon-discover-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "description": "Search for restaurants",
      "url": "/search?source=shortcut",
      "icons": [{ "src": "/icon-search-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Social",
      "short_name": "Social",
      "description": "View friend activity",
      "url": "/social?source=shortcut",
      "icons": [{ "src": "/icon-social-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "edge_side_panel": {},
  "launch_handler": {
    "client_mode": "navigate-existing"
  }
